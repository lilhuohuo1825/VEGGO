<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".VeggoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VEGGO">
        <service
            android:name=".core.firebase.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".presentation.checkout.CheckoutActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.order.OrderDetailActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.product.ProductDetailActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.community.CommunityRecipesActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.community.CommunityPostActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.community.CommunityCookbookActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.community.CommunityRecipeDetailActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.community.CommunityIngredientsActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.community.CommunityDiscoveryActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.community.CommunityProfileActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.community.CommunityFollowListActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.community.CommunityChefsActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.community.CommunityCategoriesActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.community.CommunityHomeActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.blog.BlogDetailActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.blog.BlogAllPostsActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.blog.BlogNewPostsActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.blog.BlogHomeActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.profile.SupportCustomersActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.profile.PolicyActivity"
            android:exported="true" />
        <activity
            android:name=".presentation.auth.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
