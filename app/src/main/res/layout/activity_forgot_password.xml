<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_auth" />

    <View
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="#80FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="95dp"
            android:paddingEnd="26dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:id="@+id/layoutForgotForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp">

                    <ImageView
                        android:id="@+id/imgBackForgot"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_left"
                        android:tint="@color/primary_hover" />

                    <ImageView
                        android:layout_width="78dp"
                        android:layout_height="67dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_logo_koten" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/encodesans_bold"
                    android:gravity="center"
                    android:text="QUÊN MẬT KHẨU"
                    android:textColor="#57AF37"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:text="Vui lòng nhập số điện thoại đã dùng để tạo tài khoản. Chúng tôi sẽ gửi mã xác thực để bạn đặt lại mật khẩu."
                    android:textColor="#1E1E1E"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Số điện thoại "
                        android:textColor="#1E1E1E"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*"
                        android:textColor="#E5484D"
                        android:textSize="14sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/edtForgotPhone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:fontFamily="@font/inter_regular"
                    android:hint="Nhập số điện thoại của bạn"
                    android:inputType="phone"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvForgotPhoneError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="Số điện thoại không hợp lệ."
                    android:textColor="#E5484D"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnSendOtp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_button_primary"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="Gửi mã OTP"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutForgotVerifyForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp">

                    <ImageView
                        android:id="@+id/imgBackVerifyForgot"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_left"
                        android:tint="@color/primary_hover" />

                    <ImageView
                        android:layout_width="78dp"
                        android:layout_height="67dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_logo_koten" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/encodesans_bold"
                    android:gravity="center"
                    android:text="QUÊN MẬT KHẨU"
                    android:textColor="#57AF37"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvForgotVerifyPhoneDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:text="Chúng tôi đã gửi mã xác thực đến số điện thoại"
                    android:textColor="#1E1E1E"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:text="Vui lòng nhập mã xác thực bạn đã nhận được!"
                    android:textColor="#1E1E1E"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <EditText android:id="@+id/edtForgotOtp1" style="@style/OtpBoxStyle" android:inputType="number" android:maxLength="1" />
                    <EditText android:id="@+id/edtForgotOtp2" style="@style/OtpBoxStyle" android:inputType="number" android:maxLength="1" />
                    <EditText android:id="@+id/edtForgotOtp3" style="@style/OtpBoxStyle" android:inputType="number" android:maxLength="1" />
                    <EditText android:id="@+id/edtForgotOtp4" style="@style/OtpBoxStyle" android:inputType="number" android:maxLength="1" />
                    <EditText android:id="@+id/edtForgotOtp5" style="@style/OtpBoxStyle" android:inputType="number" android:maxLength="1" />
                    <EditText android:id="@+id/edtForgotOtp6" style="@style/OtpBoxStyle" android:inputType="number" android:maxLength="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:text="Bạn chưa nhận được mã? "
                        android:textColor="#1E1E1E"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvResendForgotCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Gửi lại mã"
                        android:textColor="#57AF37"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnVerifyForgot"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_button_primary"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="Xác thực"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutResetForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp">

                    <ImageView
                        android:id="@+id/imgBackReset"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_left"
                        android:tint="@color/primary_hover" />

                    <ImageView
                        android:layout_width="78dp"
                        android:layout_height="67dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_logo_koten" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/encodesans_bold"
                    android:gravity="center"
                    android:text="ĐẶT LẠI MẬT KHẨU"
                    android:textColor="#57AF37"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Mật khẩu mới "
                        android:textColor="#1E1E1E"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*"
                        android:textColor="#E5484D"
                        android:textSize="14sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/edtNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:fontFamily="@font/inter_regular"
                        android:hint="Mật khẩu gồm ít nhất 8 ký tự, 1 chữ cái in hoa"
                        android:inputType="textPassword"
                        android:paddingEnd="46dp"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/imgEyeNewPassword"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_eye_hide_dark" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvNewPasswordError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="Mật khẩu phải có ít nhất 8 ký tự."
                    android:textColor="#E5484D"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Nhập lại mật khẩu mới "
                        android:textColor="#1E1E1E"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*"
                        android:textColor="#E5484D"
                        android:textSize="14sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/edtConfirmNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:fontFamily="@font/inter_regular"
                        android:hint="Nhập lại mật khẩu vừa nhập"
                        android:inputType="textPassword"
                        android:paddingEnd="46dp"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/imgEyeConfirmNewPassword"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_eye_hide_dark" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvConfirmNewPasswordError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="Mật khẩu nhập lại không khớp"
                    android:textColor="#E5484D"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnResetPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button_primary"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="Xác nhận"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
