<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cookbook_dialog"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="24dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Tạo cookbook mới"
        android:textColor="@color/neutral_100"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/cookbookTitleInput"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_cookbook_input"
        android:hint="Tên"
        android:inputType="textCapSentences"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/neutral_100"
        android:textColorHint="@color/neutral_60"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/cookbookDescriptionInput"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_cookbook_input"
        android:gravity="top"
        android:hint="Mô tả"
        android:inputType="textCapSentences|textMultiLine"
        android:padding="14dp"
        android:textColor="@color/neutral_100"
        android:textColorHint="@color/neutral_60"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/cookbookBackToListButton"
            android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_community_circle"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
            android:clipChildren="false"
            android:clipToPadding="false">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:scaleType="centerInside"
            app:tint="@color/primary_hover"
                android:src="@drawable/ic_left"
                android:contentDescription="" />
        </FrameLayout>

        <TextView
            android:id="@+id/cookbookCreateSaveButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary_large"
            android:gravity="center"
            android:text="Save"
            android:textColor="@color/neutral_10"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
