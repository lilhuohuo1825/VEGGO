<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md">

        <ImageView
    android:id="@+id/postNotificationsBackButton"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/orders_back"
    android:focusable="true"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_left"
    android:tint="@color/primary_hover" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/encodesans_bold"
            android:gravity="center"
            android:text="@string/profile_notifications"
            android:textColor="@color/neutral_100"
            android:textSize="@dimen/text_xl"
            android:textStyle="bold" />

        <Space
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/postNotificationCategoryScroll"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/postNotificationCategoryTabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/postNotificationTabOrders"
                android:layout_width="128dp"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/postNotificationTabOrdersText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="@string/posts_filter_orders"
                        android:textColor="@color/neutral_60"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/postNotificationTabOrdersBadge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notification_badge_dark"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="6"
                        android:textColor="@color/background_main"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/postNotificationTabOrdersIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_order_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/postNotificationTabCommunity"
                android:layout_width="144dp"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/postNotificationTabCommunityText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="@string/posts_filter_community"
                        android:textColor="@color/neutral_60"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/postNotificationTabCommunityBadge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notification_badge_dark"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:textColor="@color/background_main"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/postNotificationTabCommunityIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_order_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/postNotificationTabQa"
                android:layout_width="104dp"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/postNotificationTabQaText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="@string/posts_filter_qa"
                        android:textColor="@color/primary_main"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/postNotificationTabQaBadge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notification_badge_alert"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="6"
                        android:textColor="@color/background_main"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/postNotificationTabQaIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_order_tab_indicator" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/postNotificationTabOther"
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/postNotificationTabOtherText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="@string/posts_filter_other"
                        android:textColor="@color/neutral_60"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/postNotificationTabOtherBadge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notification_badge_dark"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:textColor="@color/background_main"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/postNotificationTabOtherIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_order_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/neutral_30" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/postNotificationsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
