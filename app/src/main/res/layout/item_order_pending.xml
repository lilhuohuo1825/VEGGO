<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orderPendingItemCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_order_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/orderPendingItemCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/orders_sample_id"
            android:textColor="@color/neutral_100"
            android:textSize="@dimen/text_sm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/orderPendingItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/bg_order_pending_chip"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:minWidth="90dp"
            android:text="@string/orders_sample_status_pending"
            android:textColor="@color/order_status_pending"
            android:textSize="@dimen/text_xs" />
    </LinearLayout>

    <TextView
        android:id="@+id/orderPendingItemId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_regular"
        android:maxLines="1"
        android:text="@string/orders_sample_id"
        android:textColor="@color/neutral_60"
        android:textSize="@dimen/text_xs" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/spacing_xs"
        android:background="@color/neutral_30" />

    <include layout="@layout/order_item_product_block" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/orderPendingViewMore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_regular"
            android:text="@string/orders_view_more"
            android:textColor="@color/neutral_80"
            android:textSize="@dimen/text_sm" />

        <TextView
            android:id="@+id/orderCancelButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_order_primary_button"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:minWidth="84dp"
            android:text="@string/orders_cancel"
            android:textColor="@color/background_main"
            android:textSize="@dimen/text_sm" />
    </LinearLayout>
</LinearLayout>
