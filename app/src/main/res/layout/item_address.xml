<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/addressItemCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_address_card"
    android:orientation="vertical"
    android:padding="18dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/addressItemTopTextGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/addressDefaultButton"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:orientation="vertical">

            <TextView
                android:id="@+id/addressItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_semibold"
                android:maxLines="1"
                android:text="@string/address_sample_name"
                android:textColor="@color/neutral_100"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/addressItemPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:fontFamily="@font/inter_regular"
                android:text="@string/address_sample_phone"
                android:textColor="@color/neutral_100"
                android:textSize="@dimen/text_md" />
        </LinearLayout>

        <TextView
            android:id="@+id/addressDefaultButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_order_cancel_button"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:minWidth="136dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/address_set_default"
            android:textColor="@color/primary_main"
            android:textSize="11sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <TextView
        android:id="@+id/addressItemLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:text="@string/address_sample_line"
        android:textColor="@color/neutral_90"
        android:textSize="@dimen/text_md" />

</LinearLayout>
