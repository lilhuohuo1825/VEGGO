<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_10"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/recipeDetailScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="70dp"
        android:paddingBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/recipeAuthorRow"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/recipeChefAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/recipeChefName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/neutral_100"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/recipeChefCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/neutral_70"
                        android:textSize="10sp" />
                </LinearLayout>


            </LinearLayout>

            <FrameLayout
                android:id="@+id/recipeHeroCard"
                android:layout_width="match_parent"
                android:layout_height="282dp"
                android:layout_marginTop="16dp">

                <ImageView
                    android:id="@+id/recipeHeroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_community_overlay" />

                <TextView
                    android:id="@+id/recipePlay"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_community_circle"
                    android:gravity="center"
                    android:text="&#x25B6;"
                    android:textColor="@color/neutral_10"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/recipeMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/neutral_10"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/recipeTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="2"
                        android:textColor="@color/neutral_10"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/recipeStats"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_recipe_stat_card"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/recipeCalories"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/neutral_100"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recipeSalt"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/neutral_100"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recipeSugar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/neutral_100"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Nguyên liệu"
                android:textColor="@color/neutral_100"
                android:textSize="24sp"
                android:textStyle="bold" />

            <GridLayout
                android:id="@+id/recipeIngredientsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Hướng dẫn"
                android:textColor="@color/neutral_100"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/recipeInstructionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/recipeShopButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_primary"
                android:backgroundTint="@null"
                android:text="Mua sắm"
                android:textAllCaps="false"
                android:textColor="@color/neutral_10"
                android:textSize="16sp"
                app:backgroundTint="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Thư viện ảnh"
                    android:textColor="@color/neutral_100"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xem thêm"
                    android:textColor="@color/primary_main"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recipeGalleryRow"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bình luận"
                    android:textColor="@color/neutral_100"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/recipeCommentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/recipeDiscussBox"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_discovery_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <EditText
                    android:id="@+id/recipeCommentInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Viết bình luận ở đây"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="3"
                    android:minHeight="36dp"
                    android:padding="0dp"
                    android:textColor="@color/neutral_100"
                    android:textColorHint="@color/neutral_60"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/recipeCommentSend"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_prime_send"
                    app:tint="@color/primary_main" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/recipeBackButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_community_circle"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:layout_marginStart="18dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:clipChildren="false"
        android:clipToPadding="false">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:scaleType="centerInside"
            app:tint="@color/primary_hover"
            android:src="@drawable/ic_left"
            android:contentDescription="" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/recipeActionRow"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="14dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/recipeEditButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_community_circle"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                app:tint="#57AF37"
                android:src="@drawable/ic_edit"
                android:contentDescription="" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/recipeDeleteButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_community_circle"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                app:tint="#57AF37"
                android:src="@drawable/ic_trash"
                android:contentDescription="" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/recipeBookmarkButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_community_circle"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                app:tint="#57AF37"
                android:src="@drawable/ic_bookmark_green"
                android:contentDescription="" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/recipeShareButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_community_circle"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                app:tint="#57AF37"
                android:src="@drawable/ic_share_green"
                android:contentDescription="" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
