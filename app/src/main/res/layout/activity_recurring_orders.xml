<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background_main">

    <ScrollView
        android:id="@+id/recurringOrdersScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_main"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
    android:id="@+id/recurringOrdersBackButton"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/orders_back"
    android:focusable="true"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_left"
    android:tint="@color/primary_hover" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_bold"
                android:gravity="center"
                android:text="@string/recurring_title"
                android:textColor="@color/neutral_100"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/recurringOrdersMenuButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/orders_menu"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_order_list_menu" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/recurringCalendarCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/recurringPrevMonthButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/primary_hover"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recurringMonthTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/encodesans_bold"
                    android:gravity="center"
                    android:text="@string/recurring_month_title"
                    android:textColor="@color/neutral_100"
                    android:textSize="@dimen/text_xl"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recurringNextMonthButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="@color/primary_hover"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <include layout="@layout/recurring_calendar_grid" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/recurring_scheduled_orders_title"
                android:textColor="@color/neutral_100"
                android:textSize="@dimen/text_md" />

            <LinearLayout
                android:id="@+id/recurringScheduledOrdersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/recurringEmptyListText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_recurring_input"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:padding="@dimen/spacing_md"
                android:text="@string/recurring_empty_title"
                android:textColor="@color/neutral_70"
                android:textSize="@dimen/text_sm" />

            <TextView
                android:id="@+id/recurringCreateButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_order_primary_button"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="@string/recurring_create_button"
                android:textColor="@color/background_main"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_profile_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/encodesans_bold"
                android:text="@string/recurring_suggestion_title"
                android:textColor="@color/neutral_100"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:fontFamily="@font/inter_regular"
                android:lineSpacingExtra="4dp"
                android:text="@string/recurring_suggestion_body"
                android:textColor="@color/neutral_80"
                android:textSize="@dimen/text_md" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
</FrameLayout>
