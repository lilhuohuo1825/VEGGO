<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingStart="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/returnsBackButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/orders_back"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_left" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/encodesans_bold"
                android:gravity="center"
                android:text="@string/returns_title"
                android:textColor="@color/neutral_100"
                android:textSize="@dimen/text_xl"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/orders_menu"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_order_list_menu" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/returnPendingTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/returnPendingTabText"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="@string/returns_tab_pending"
                    android:textColor="@color/primary_main"
                    android:textSize="@dimen/text_xs" />

                <ImageView
                    android:id="@+id/returnPendingIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_order_tab_indicator" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/returnProcessingTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/returnProcessingTabText"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="@string/returns_tab_processing"
                    android:textColor="@color/neutral_60"
                    android:textSize="@dimen/text_xs" />

                <ImageView
                    android:id="@+id/returnProcessingIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_order_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/returnCompletedTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/returnCompletedTabText"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="@string/returns_tab_completed"
                    android:textColor="@color/neutral_60"
                    android:textSize="@dimen/text_xs" />

                <ImageView
                    android:id="@+id/returnCompletedIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_order_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/returnRejectedTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/returnRejectedTabText"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="@string/returns_tab_rejected"
                    android:textColor="@color/neutral_60"
                    android:textSize="@dimen/text_xs" />

                <ImageView
                    android:id="@+id/returnRejectedIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_order_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/returnTabsDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/neutral_30" />

        <LinearLayout
            android:id="@+id/returnPendingList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical">

            <include layout="@layout/item_return_pending" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/returnProcessingList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/item_return_processing" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/returnCompletedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/item_return_completed" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/returnRejectedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/item_return_rejected" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
