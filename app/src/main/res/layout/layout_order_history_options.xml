<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orderOptionsOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/order_sheet_scrim">

    <LinearLayout
        android:id="@+id/orderOptionsSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_orders_option_sheet"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_orders_option_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/orders_option_history"
                android:src="@drawable/ic_order_history_option" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:text="@string/orders_option_history"
                android:textColor="@color/neutral_90"
                android:textSize="@dimen/text_md" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/orderOptionRecurring"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_orders_option_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/orders_option_recurring"
                android:src="@drawable/ic_order_recurring_option" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:text="@string/orders_option_recurring"
                android:textColor="@color/neutral_90"
                android:textSize="@dimen/text_md" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/orderOptionReviews"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_orders_option_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/orders_option_reviews"
                android:src="@drawable/ic_order_review_option" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:text="@string/orders_option_reviews"
                android:textColor="@color/neutral_90"
                android:textSize="@dimen/text_md" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/orderOptionReturns"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_orders_option_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/orders_option_returns"
                android:src="@drawable/ic_order_return_option" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:text="@string/orders_option_returns"
                android:textColor="@color/neutral_90"
                android:textSize="@dimen/text_md" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
