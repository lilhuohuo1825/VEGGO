<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/returnRejectedItemCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_order_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/returnOrderCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/orders_sample_id_cancelled"
            android:textColor="@color/neutral_100"
            android:textSize="@dimen/text_sm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/returnOrderStatus"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/bg_order_cancelled_chip"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:minWidth="90dp"
            android:text="@string/returns_status_rejected"
            android:textColor="@color/danger_main"
            android:textSize="@dimen/text_xs" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/neutral_30" />

    <include layout="@layout/order_item_product_block" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:background="@drawable/bg_recurring_input"
        android:orientation="vertical"
        android:padding="@dimen/spacing_sm">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/returns_rejected_reason_label"
            android:textColor="@color/danger_main"
            android:textSize="@dimen/text_xs" />

        <TextView
            android:id="@+id/returnRejectReasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/returns_rejected_reason"
            android:textColor="@color/neutral_80"
            android:textSize="@dimen/text_xs" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="end|center_vertical">

        <TextView
            android:id="@+id/returnBuyAgainButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_order_primary_button"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="104dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/orders_buy_again"
            android:textColor="@color/background_main"
            android:textSize="@dimen/text_sm" />
    </LinearLayout>
</LinearLayout>
