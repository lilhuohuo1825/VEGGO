<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_10"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/communityPostBackButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_community_circle"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription=""
            android:scaleType="centerInside"
            android:src="@drawable/ic_left"
            app:tint="#57AF37" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/communityPostScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="92dp"
        app:layout_constraintBottom_toTopOf="@id/communityPostBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/communityPostBackButton">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="10dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/communityPostCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_post_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đăng công thức"
                    android:textColor="@color/primary_hover"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Tên món ăn"
                    android:textColor="@color/neutral_100"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/communityPostTitleInput"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_post_input"
                    android:hint="Ví dụ: Salad cải kale sốt mè rang"
                    android:inputType="textCapSentences|textAutoCorrect"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/neutral_100"
                    android:textColorHint="@color/neutral_60"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/communityPostTitleError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/danger_main"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Danh mục"
                    android:textColor="@color/neutral_100"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/communityPostCategoryButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_post_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Chọn danh mục"
                    android:textColor="@color/neutral_60"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/communityPostCategoryError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/danger_main"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Ảnh món ăn"
                    android:textColor="@color/neutral_100"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/communityPostImagePickerButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_post_upload"
                    android:gravity="center"
                    android:text="+  Thêm ảnh từ thư viện hoặc camera"
                    android:textColor="@color/primary_main"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:id="@+id/communityPostImagePreviewScroll"
                    android:layout_width="match_parent"
                    android:layout_height="98dp"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/communityPostImagePreviewRow"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/communityPostImageError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/danger_main"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Link video"
                    android:textColor="@color/neutral_100"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/communityPostVideoInput"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_post_input"
                    android:hint="Dán link YouTube, TikTok hoặc video khác"
                    android:inputType="textUri"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/neutral_100"
                    android:textColorHint="@color/neutral_60"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Nguyên liệu"
                    android:textColor="@color/neutral_100"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/communityPostAddIngredientButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_button_outline_green"
                    android:gravity="center"
                    android:text="+  Chọn sản phẩm Veggo"
                    android:textColor="@color/primary_main"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/communityPostIngredientsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/communityPostIngredientsError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/danger_main"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Các bước nấu"
                    android:textColor="@color/neutral_100"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/communityPostStepsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/communityPostAddStepButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_outline_green"
                    android:gravity="center"
                    android:text="+  Thêm bước nấu"
                    android:textColor="@color/primary_main"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/communityPostStepsError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/danger_main"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Dinh dưỡng"
                    android:textColor="@color/neutral_100"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/communityPostCaloriesInput"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_post_input"
                        android:hint="Calo"
                        android:inputType="number"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="@color/neutral_100"
                        android:textColorHint="@color/neutral_60"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/communityPostSaltInput"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_post_input"
                        android:hint="Muối"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="@color/neutral_100"
                        android:textColorHint="@color/neutral_60"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/communityPostSugarInput"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_post_input"
                        android:hint="Đường"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="@color/neutral_100"
                        android:textColorHint="@color/neutral_60"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/communityPostNutritionError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/danger_main"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/communityPostFormError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/danger_main"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/communityPostBottomBar"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:background="@color/neutral_10"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/communityPostDraftViewButton"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_outline_green"
            android:gravity="center"
            android:text="Xem nháp"
            android:textColor="@color/primary_main"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/communityPostDraftButton"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_outline_green"
            android:gravity="center"
            android:text="Lưu nháp"
            android:textColor="@color/primary_main"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/communityPostSubmitButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary_large"
            android:gravity="center"
            android:text="Đăng bài"
            android:textColor="@color/neutral_10"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
