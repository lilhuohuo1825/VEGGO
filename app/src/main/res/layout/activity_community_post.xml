<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_10">

    <ImageButton
        android:id="@+id/communityPostBackButton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_community_circle"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_left"
        android:tint="@color/primary_main"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/communityPostScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="92dp"
        app:layout_constraintBottom_toTopOf="@id/communityPostBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/communityPostBackButton">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="10dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/communityPostCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_post_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                    android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đăng lên cộng đồng Bếp xanh"
                    android:textColor="@color/primary_hover"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Tiêu đề bài viết"
                    android:textColor="@color/neutral_100"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/communityPostTitleInput"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_post_input"
                    android:hint="Ví dụ: Bữa tối xanh từ cải kale"
                    android:inputType="textCapSentences"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/neutral_100"
                    android:textColorHint="@color/neutral_60"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Nội dung chia sẻ"
                    android:textColor="@color/neutral_100"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/communityPostContentInput"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_post_input"
                    android:gravity="top"
                    android:hint="Viết câu chuyện, mẹo nấu ăn hoặc trải nghiệm của bạn..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="12dp"
                    android:textColor="@color/neutral_100"
                    android:textColorHint="@color/neutral_60"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Ảnh / video"
                    android:textColor="@color/neutral_100"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/communityPostUploadBox"
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:background="@drawable/bg_post_upload"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/communityPostUploadPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/communityPostUploadPlus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+"
                        android:textColor="@color/primary_main"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/communityPostUploadHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Thêm ảnh hoặc video món ăn"
                        android:textColor="@color/neutral_70"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Nguyên liệu"
                    android:textColor="@color/neutral_100"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/communityPostIngredientsInput"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_post_input"
                    android:gravity="top"
                    android:hint="Cải kale, tôm, hành tím, gia vị..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="12dp"
                    android:textColor="@color/neutral_100"
                    android:textColorHint="@color/neutral_60"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Các bước nấu"
                    android:textColor="@color/neutral_100"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/communityPostStepsInput"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_post_input"
                    android:gravity="top"
                    android:hint="Bước 1: Sơ chế rau. Bước 2: Nấu nước dùng..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="12dp"
                    android:textColor="@color/neutral_100"
                    android:textColorHint="@color/neutral_60"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/communityPostBottomBar"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:background="@color/neutral_10"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="72dp"
        android:paddingEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/communityPostDraftButton"
            android:layout_width="96dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_outline_green"
            android:gravity="center"
            android:text="Lưu nháp"
            android:textColor="@color/primary_main"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/communityPostSubmitButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary_large"
            android:gravity="center"
            android:text="Đăng bài"
            android:textColor="@color/neutral_10"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
