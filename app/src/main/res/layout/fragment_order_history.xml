<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orderHistoryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/orderHistoryHeader"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/background_main"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md">

        <ImageView
    android:id="@+id/orderHistoryBackButton"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/orders_back"
    android:focusable="true"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_left"
    android:tint="@color/primary_hover" />

        <TextView
            android:id="@+id/orderHistoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:text="@string/orders_title"
            android:textColor="@color/neutral_100"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/orderHistoryMenuButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/orders_menu"
            android:focusable="false"
            android:padding="@dimen/spacing_sm"
            android:scaleType="centerInside"
            android:src="@drawable/ic_order_list_menu" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:background="#616161" />

    <LinearLayout
        android:id="@+id/orderSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:background="@drawable/bg_order_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <EditText
            android:id="@+id/orderSearchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/inter_regular"
            android:hint="Tìm theo tên đơn, mã đơn, hoặc tên sản phẩm"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/neutral_100"
            android:textColorHint="@color/neutral_60"
            android:textSize="@dimen/text_sm" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            android:tint="@color/neutral_60" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/orderStatusScroll"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/background_main"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/orderStatusTabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/orderTabAll"
                android:layout_width="112dp"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/orderTabAllText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="@string/orders_tab_all"
                        android:textColor="@color/primary_main"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/orderTabAllBadge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notification_badge_tab"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:textColor="@color/background_main"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/orderTabAllIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_order_tab_indicator" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/orderTabPending"
                android:layout_width="152dp"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/orderTabPendingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="@string/orders_tab_pending"
                        android:textColor="@color/neutral_60"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderTabPendingBadge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notification_badge_dark"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:textColor="@color/background_main"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/orderTabPendingIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_order_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/orderTabShipping"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/orderTabShippingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="@string/orders_tab_shipping"
                        android:textColor="@color/neutral_60"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderTabShippingBadge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notification_badge_dark"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:textColor="@color/background_main"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/orderTabShippingIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_order_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/orderTabDelivered"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/orderTabDeliveredText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="@string/orders_tab_delivered"
                        android:textColor="@color/neutral_60"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderTabDeliveredBadge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notification_badge_dark"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:textColor="@color/background_main"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/orderTabDeliveredIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_order_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/orderTabCancelled"
                android:layout_width="112dp"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/orderTabCancelledText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="@string/orders_tab_cancelled"
                        android:textColor="@color/neutral_60"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderTabCancelledBadge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notification_badge_dark"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:textColor="@color/background_main"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/orderTabCancelledIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_order_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/neutral_30" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/orderHistorySwipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:id="@+id/orderListScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background_main"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingBottom="100dp">

                <LinearLayout
                    android:id="@+id/orderListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/orderEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_xl"
                android:paddingEnd="@dimen/spacing_xl"
                android:visibility="gone">

                <ImageView
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:contentDescription="@string/orders_empty_title"
                    android:src="@drawable/ic_order_empty_mascot" />

                <TextView
                    android:id="@+id/orderEmptyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:fontFamily="@font/encodesans_bold"
                    android:gravity="center"
                    android:text="@string/orders_empty_title"
                    android:textColor="@color/neutral_100"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/orderEmptyBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/orders_empty_body"
                    android:textColor="@color/neutral_70"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/orderEmptyShopButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:background="@drawable/bg_order_primary_button"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="@string/orders_empty_shop_now"
                    android:textColor="@color/background_main"
                    android:textSize="@dimen/text_sm"
                    android:textStyle="bold" />
            </LinearLayout>

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
