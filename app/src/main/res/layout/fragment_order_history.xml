<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orderHistoryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/orderHistoryHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md">

        <ImageView
    android:id="@+id/orderHistoryBackButton"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/orders_back"
    android:focusable="true"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_left"
    android:tint="@color/primary_hover" />

        <TextView
            android:id="@+id/orderHistoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/encodesans_bold"
            android:gravity="center"
            android:text="@string/orders_title"
            android:textColor="@color/neutral_100"
            android:textSize="@dimen/text_xl"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/orderHistoryMenuButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/orders_menu"
            android:padding="@dimen/spacing_sm"
            android:src="@drawable/ic_order_list_menu" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/orderStatusScroll"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/orderStatusTabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/orderTabAll"
                android:layout_width="112dp"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/orderTabAllText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="@string/orders_tab_all"
                        android:textColor="@color/primary_main"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/orderTabAllBadge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notification_badge_alert"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:textColor="@color/background_main"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/orderTabAllIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_order_tab_indicator" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/orderTabPending"
                android:layout_width="152dp"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/orderTabPendingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="@string/orders_tab_pending"
                        android:textColor="@color/neutral_60"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderTabPendingBadge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notification_badge_dark"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:textColor="@color/background_main"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/orderTabPendingIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_order_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/orderTabShipping"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/orderTabShippingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="@string/orders_tab_shipping"
                        android:textColor="@color/neutral_60"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderTabShippingBadge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notification_badge_dark"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:textColor="@color/background_main"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/orderTabShippingIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_order_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/orderTabDelivered"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/orderTabDeliveredText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="@string/orders_tab_delivered"
                        android:textColor="@color/neutral_60"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderTabDeliveredBadge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notification_badge_dark"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:textColor="@color/background_main"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/orderTabDeliveredIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_order_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/orderTabCancelled"
                android:layout_width="112dp"
                android:layout_height="match_parent"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/orderTabCancelledText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="@string/orders_tab_cancelled"
                        android:textColor="@color/neutral_60"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderTabCancelledBadge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_notification_badge_dark"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:textColor="@color/background_main"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/orderTabCancelledIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_order_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/neutral_30" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/orderListScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_main"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <LinearLayout
                android:id="@+id/orderListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/item_order_pending" />
                <include layout="@layout/item_order_shipping" />
                <include layout="@layout/item_order_delivered" />
                <include layout="@layout/item_order_cancelled" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/orderEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xl"
            android:paddingEnd="@dimen/spacing_xl"
            android:visibility="gone">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="@string/orders_empty_title"
                android:src="@drawable/ic_order_empty_mascot" />

            <TextView
                android:id="@+id/orderEmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:fontFamily="@font/encodesans_bold"
                android:gravity="center"
                android:text="@string/orders_empty_title"
                android:textColor="@color/neutral_100"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderEmptyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/orders_empty_body"
                android:textColor="@color/neutral_70"
                android:textSize="@dimen/text_sm" />

            <TextView
                android:id="@+id/orderEmptyShopButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_order_primary_button"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="@string/orders_empty_shop_now"
                android:textColor="@color/background_main"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
