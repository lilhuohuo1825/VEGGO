<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background_main">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="104dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView
    android:id="@+id/carbonCertificateBackButton"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/orders_back"
    android:focusable="true"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_left"
    android:tint="@color/primary_hover" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/encodesans_bold" android:gravity="center" android:text="@string/carbon_certificate_title" android:textColor="@color/neutral_100" android:textSize="@dimen/text_xl" android:textStyle="bold" />
                <Space android:layout_width="40dp" android:layout_height="40dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="300dp" android:layout_marginTop="@dimen/spacing_lg" android:background="@drawable/bg_carbon_hero_card" android:gravity="center" android:orientation="vertical" android:padding="@dimen/spacing_lg">
                <FrameLayout android:layout_width="112dp" android:layout_height="112dp" android:background="@drawable/bg_carbon_icon_circle">
                    <ImageView android:layout_width="54dp" android:layout_height="54dp" android:layout_gravity="center" android:contentDescription="@string/carbon_certificate_title" android:src="@drawable/ic_profile_leaf" />
                </FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg" android:fontFamily="@font/inter_semibold" android:gravity="center" android:text="@string/carbon_certificate_label" android:textColor="@color/primary_hover" android:textSize="@dimen/text_sm" android:textStyle="bold" />
                <TextView android:id="@+id/carbonCertificateName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:autoSizeMaxTextSize="22sp" android:autoSizeMinTextSize="16sp" android:autoSizeStepGranularity="1sp" android:autoSizeTextType="uniform" android:fontFamily="@font/encodesans_bold" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:singleLine="true" android:textColor="@color/primary_hover" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/carbonCertificatePoints" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginTop="@dimen/spacing_sm" android:background="@drawable/bg_carbon_badge" android:fontFamily="@font/inter_semibold" android:gravity="center" android:minWidth="104dp" android:textColor="@color/primary_hover" android:textSize="@dimen/text_sm" />
                <TextView android:id="@+id/carbonCertificateStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:fontFamily="@font/inter_semibold" android:gravity="center" android:textColor="@color/neutral_80" android:textSize="@dimen/text_xs" />
                <TextView android:id="@+id/carbonCertificateDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:gravity="center" android:lineSpacingExtra="3dp" android:textColor="@color/neutral_70" android:textSize="@dimen/text_sm" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg" android:background="@drawable/bg_profile_card" android:orientation="vertical" android:padding="@dimen/spacing_lg">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/encodesans_bold" android:text="@string/carbon_certificate_path" android:textColor="@color/neutral_100" android:textSize="@dimen/text_lg" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:text="Các mốc được lấy từ dữ liệu certificate hiện tại." android:textColor="@color/neutral_70" android:textSize="@dimen/text_sm" />
                <LinearLayout android:id="@+id/carbonCertificatePathList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="84dp" android:layout_gravity="bottom" android:background="@color/background_main" android:elevation="8dp" android:gravity="center" android:paddingStart="@dimen/spacing_xl" android:paddingEnd="@dimen/spacing_xl">
        <TextView android:id="@+id/carbonShareButton" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_order_primary_button" android:fontFamily="@font/inter_semibold" android:gravity="center" android:text="@string/carbon_share_certificate" android:textColor="@color/background_main" android:textSize="@dimen/text_md" />
    </LinearLayout>
</FrameLayout>
