<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F7"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/policiesScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="0dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="14dp"
            android:text="Khám phá các chính sách của Veggo để có trải nghiệm mua sắm trọn vẹn — minh bạch và đáng tin cậy."
            android:textColor="#8A8D91"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/returnCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/neutral_10"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="#ECEEF0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/returnHeader"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        app:cardBackgroundColor="@color/primary_main"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/returnIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_return"
                            app:tint="@color/neutral_10" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/returnTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_bold"
                        android:text="Chính sách đổi trả"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/returnArrow"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_button_primary"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_chevron_up"
                        app:tint="@color/neutral_10" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/returnContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="17dp"
                            android:background="@color/primary_main" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/inter_bold"
                            android:text="Thời gian đổi trả"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:text="Chúng tôi chấp nhận đổi trả trong vòng 7 ngày kể từ ngày nhận hàng. Sản phẩm phải còn nguyên vẹn, chưa qua sử dụng và đầy đủ hóa đơn, bao bì."
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="17dp"
                            android:background="@color/primary_main" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/inter_bold"
                            android:text="Điều kiện đổi trả nông sản tươi sống"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:text="Đối với nông sản tươi sống, thời gian đổi trả là 24 giờ kể từ khi nhận hàng nếu:"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingStart="24dp"
                        android:paddingEnd="8dp"
                        android:text="• Sản phẩm bị hư hỏng do vận chuyển"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingStart="24dp"
                        android:paddingEnd="8dp"
                        android:text="• Sản phẩm không đúng chất lượng cam kết"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingStart="24dp"
                        android:paddingEnd="8dp"
                        android:text="• Sản phẩm giao sai loại hoặc thiếu số lượng"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="17dp"
                            android:background="@color/primary_main" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/inter_bold"
                            android:text="Quy trình đổi trả"
                            android:textStyle="bold"
                            android:textColor="#222222"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="8dp"
                        android:text="●  Chụp ảnh/quay video sản phẩm cần đổi trả"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="8dp"
                        android:text="●  Liên hệ hotline 0123 456 789 hoặc email vgreenhotro@gmail.com"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="8dp"
                        android:text="●  Đóng gói và chờ nhân viên đến lấy hàng"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="8dp"
                        android:text="●  Nhận sản phẩm mới hoặc hoàn tiền trong 3-5 ngày làm việc"
                        android:textColor="#333333"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@color/primary_bg"
                        android:lineSpacingExtra="4dp"
                        android:padding="14dp"
                        android:text="Lưu ý: Chi phí vận chuyển đổi trả do cửa hàng chịu trong trường hợp lỗi từ phía chúng tôi."
                        android:textColor="#333333"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/paymentCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/neutral_10"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="#ECEEF0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/paymentHeader"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        app:cardBackgroundColor="@color/primary_main"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_wallet"
                            app:tint="@color/neutral_10" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_bold"
                        android:text="Chính sách thanh toán"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/paymentArrow"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/neutral_70" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/paymentContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/privacyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/neutral_10"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="#ECEEF0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/privacyHeader"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        app:cardBackgroundColor="@color/primary_main"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_shield_check"
                            app:tint="@color/neutral_10" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_bold"
                        android:text="Chính sách bảo mật"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/privacyArrow"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/neutral_70" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/privacyContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/shippingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/neutral_10"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="#ECEEF0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/shippingHeader"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        app:cardBackgroundColor="@color/primary_main"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_order_green"
                            app:tint="@color/neutral_10" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_bold"
                        android:text="Chính sách giao hàng"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/shippingArrow"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/neutral_70" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/shippingContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/warrantyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/neutral_10"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="#ECEEF0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/warrantyHeader"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        app:cardBackgroundColor="@color/primary_main"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_green_cert"
                            app:tint="@color/neutral_10" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_bold"
                        android:text="Chính sách bảo hành"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/warrantyArrow"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/neutral_70" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/warrantyContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/neutral_10"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:translationZ="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/orders_back"
            android:focusable="true"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_left"
            app:tint="@color/primary_hover" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:text="Chính sách &amp; Điều khoản"
            android:textColor="#1F1F1F"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/notifyButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/nav_account"
            android:focusable="true"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notify"
            app:tint="@color/primary_hover" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
