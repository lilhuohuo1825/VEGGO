<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cookbookOptionRoot"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:background="@drawable/bg_community_chip"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/cookbookOptionImage"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cookbookOptionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/neutral_100"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cookbookOptionCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/neutral_70"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
