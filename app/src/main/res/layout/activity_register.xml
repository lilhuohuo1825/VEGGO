<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_admin" />

    <View
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="#80FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="95dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp">

                    <ImageView
    android:id="@+id/imgBack"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_gravity="start|center_vertical"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_left"
    android:tint="@color/primary_hover" />

                    <ImageView
                        android:id="@+id/imgLogo"
                        android:layout_width="78dp"
                        android:layout_height="67dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_logo_koten" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/encodesans_bold"
                    android:gravity="center"
                    android:text="ĐĂNG KÝ"
                    android:textColor="#57AF37"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Số điện thoại -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Số điện thoại "
                        android:textColor="#1E1E1E"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*"
                        android:textColor="#E5484D"
                        android:textSize="14sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/edtPhone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:fontFamily="@font/inter_regular"
                    android:hint="Nhập số điện thoại của bạn"
                    android:inputType="phone"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvPhoneError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="Số điện thoại không hợp lệ."
                    android:textColor="#E5484D"
                    android:textSize="12sp" />

                <!-- Mật khẩu -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Mật khẩu "
                        android:textColor="#1E1E1E"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*"
                        android:textColor="#E5484D"
                        android:textSize="14sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/edtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:fontFamily="@font/inter_regular"
                        android:hint="Mật khẩu gồm ít nhất 8 ký tự, 1 chữ cái in hoa"
                        android:inputType="textPassword"
                        android:paddingEnd="46dp"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/imgEyePassword"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_eye_hide_dark" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvPasswordError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="Mật khẩu phải có ít nhất 8 ký tự."
                    android:textColor="#E5484D"
                    android:textSize="12sp" />

                <!-- Nhập lại mật khẩu -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Nhập lại mật khẩu "
                        android:textColor="#1E1E1E"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*"
                        android:textColor="#E5484D"
                        android:textSize="14sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/edtConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:fontFamily="@font/inter_regular"
                        android:hint="Nhập lại mật khẩu vừa nhập"
                        android:inputType="textPassword"
                        android:paddingEnd="46dp"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/imgEyeConfirmPassword"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_eye_hide_dark" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvConfirmPasswordError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="Mật khẩu nhập lại không khớp"
                    android:textColor="#E5484D"
                    android:textSize="12sp" />

                <!-- Checkbox điều khoản -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbPolicy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#57AF37"
                        android:checked="true" />

                    <TextView
                        android:id="@+id/tvPolicy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:text="Tôi đã đọc và đồng ý với Chính sách &amp; Quy định."
                        android:textColor="#1E1E1E"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_button_primary"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Đăng ký"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/layoutVerifyForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="95dp"
                android:paddingBottom="40dp"
                android:visibility="visible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp">

                    <ImageView
    android:id="@+id/imgBackVerify"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_gravity="start|center_vertical"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_left"
    android:tint="@color/primary_hover" />

                    <ImageView
                        android:layout_width="78dp"
                        android:layout_height="67dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_logo_koten" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/encodesans_bold"
                    android:gravity="center"
                    android:text="XÁC THỰC TÀI KHOẢN"
                    android:textColor="#57AF37"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:text="Chúng tôi đã gửi mã xác thực đến số điện thoại 0915****03"
                    android:textColor="#1E1E1E"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"
                    android:text="Vui lòng nhập mã xác thực bạn đã nhận được!"
                    android:textColor="#1E1E1E"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <EditText
                        style="@style/OtpBoxStyle"
                        tools:ignore="SpeakableTextPresentCheck" />
                    <EditText style="@style/OtpBoxStyle"
                        tools:ignore="SpeakableTextPresentCheck"/>
                    <EditText style="@style/OtpBoxStyle"
                        tools:ignore="SpeakableTextPresentCheck"/>
                    <EditText style="@style/OtpBoxStyle"
                        tools:ignore="SpeakableTextPresentCheck"/>
                    <EditText style="@style/OtpBoxStyle"
                        tools:ignore="SpeakableTextPresentCheck"/>
                    <EditText style="@style/OtpBoxStyle"
                        tools:ignore="SpeakableTextPresentCheck"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnVerify"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button_primary"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Xác thực"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:text="Bạn chưa nhận được mã? "
                        android:textColor="#1E1E1E"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvResendCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Gửi lại mã"
                        android:textColor="#57AF37"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
