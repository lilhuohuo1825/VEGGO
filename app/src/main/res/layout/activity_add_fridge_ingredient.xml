<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md">

        <ImageView
            android:id="@+id/addFridgeBackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/orders_back"
            android:focusable="true"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_left"
            android:tint="@color/primary_hover" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/encodesans_bold"
            android:gravity="center"
            android:text="@string/fridge_add_title"
            android:textColor="@color/neutral_100"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold" />

        <Space android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Scan card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_order_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:text="@string/fridge_scan_fast"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_md"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/fridge_scan_fast_subtitle"
                        android:textColor="@color/neutral_70"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/fridgeQuickScanButton"
                        android:layout_width="160dp"
                        android:layout_height="42dp"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:background="@drawable/bg_order_primary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="@string/fridge_scan_invoice"
                        android:textAllCaps="true"
                        android:textColor="@color/background_main"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:background="@drawable/bg_fridge_scan_box">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_scan"
                        android:tint="@color/primary_main" />
                </FrameLayout>
            </LinearLayout>

            <!-- Dynamic container for multiple manual input blocks -->
            <LinearLayout
                android:id="@+id/fridgeManualBlocksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
                
            <!-- Nút Thêm sản phẩm khác -->
            <TextView
                android:id="@+id/fridgeAddAnotherBlockBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="+ Thêm nguyên liệu khác"
                android:textColor="@color/primary_main"
                android:textSize="@dimen/text_sm"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:background="@color/background_main"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <TextView
            android:id="@+id/addFridgeCancelButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_order_cancel_button"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/fridge_cancel"
            android:textColor="@color/primary_main"
            android:textSize="@dimen/text_sm"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/addFridgeSaveButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1.35"
            android:background="@drawable/bg_order_primary_button"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/fridge_save"
            android:textColor="@color/background_main"
            android:textSize="@dimen/text_sm"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
