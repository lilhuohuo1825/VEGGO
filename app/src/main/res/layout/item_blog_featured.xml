<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blogFeaturedRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="198dp">

        <ImageView
            android:id="@+id/blogFeaturedImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <ImageButton
            android:id="@+id/blogFeaturedLikeButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_category_circle"
            android:contentDescription="Yêu thích bài viết"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_heart_outline_green"
            android:tint="@color/primary_main" />
    </FrameLayout>

    <TextView
        android:id="@+id/blogFeaturedCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/neutral_70"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/blogFeaturedTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/neutral_100"
        android:textSize="15sp" />

    <include
        android:id="@+id/blogFeaturedMeta"
        layout="@layout/layout_blog_meta" />
</LinearLayout>
