<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_rounded_8"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_semibold"
        android:text="Thêm vị trí mới"
        android:textColor="@color/neutral_100"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/inter"
        android:lineSpacingExtra="2dp"
        android:text="Đặt tên ngăn tủ để dễ tìm nguyên liệu sau này."
        android:textColor="@color/neutral_60"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter_medium"
        android:text="Tên vị trí"
        android:textColor="@color/neutral_100"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/dialogLocationNameInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:fontFamily="@font/inter"
        android:hint="Ví dụ: Ngăn đá, Ngăn rau..."
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:textColor="@color/neutral_100"
        android:textColorHint="@color/neutral_60"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dialogLocationCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_normal"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Huỷ"
            android:textColor="@color/neutral_100"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dialogLocationConfirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Xác nhận"
            android:textColor="@color/background_main"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
