<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#102015">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/blogDetailRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:id="@+id/blogDetailScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

        <LinearLayout
            android:id="@+id/blogDetailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="340dp">

                <ImageView
                    android:id="@+id/blogDetailHeroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="-6dp"
                android:layout_marginEnd="4dp"
                app:cardBackgroundColor="@color/neutral_10"
                app:cardElevation="0dp"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingTop="30dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="28dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/blogDetailAuthorAvatar"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_community_avatar"
                            android:gravity="center"
                            android:textColor="@color/neutral_10"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/blogDetailAuthor"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:textColor="@color/neutral_100"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/blogDetailLikeIcon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="8dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_heart_outline_green"
                            android:tint="@color/primary_main" />

                        <ImageView
                            android:id="@+id/blogDetailCommentIcon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="Bình luận"
                            android:padding="8dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_message"
                            android:tint="@color/neutral_70" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/blogDetailCategory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:textColor="@color/neutral_70"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/blogDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/neutral_100"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/blogDetailDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/neutral_60"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/neutral_30" />

                    <TextView
                        android:id="@+id/blogDetailBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/neutral_90"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/blogCommentsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Bình luận"
                        android:textColor="@color/neutral_100"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/blogCommentInputRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/blogCommentInput"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_post_input"
                            android:hint="Để lại bình luận..."
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="3"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="@color/neutral_100"
                            android:textColorHint="@color/neutral_60"
                            android:textSize="13sp" />

                        <ImageButton
                            android:id="@+id/blogCommentSend"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_category_circle"
                            android:contentDescription="Gửi bình luận"
                            android:padding="10dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_send"
                            android:tint="@color/primary_main" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/blogCommentsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <FrameLayout
        android:id="@+id/blogDetailHeader"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:paddingStart="16dp"
        android:paddingTop="44dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
