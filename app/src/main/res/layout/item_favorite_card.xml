<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm">

    <TextView
        android:id="@+id/favoriteDeleteAction"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/danger_main"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:text="Xoá"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/favoriteForeground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_favorite_item_white"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="112dp"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_sm">

        <ImageView
            android:id="@+id/favoriteImage"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_order_product_thumb"
            android:contentDescription="@string/favorites_saved"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_vegetable" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/favoriteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_extrabold"
                android:maxLines="2"
                android:textColor="@color/neutral_100"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/favoriteSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/neutral_60"
                android:textSize="@dimen/text_sm" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
