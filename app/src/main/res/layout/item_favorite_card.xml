<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/bg_order_card"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="112dp"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_sm">

    <ImageView
        android:id="@+id/favoriteImage"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_order_product_thumb"
        android:contentDescription="@string/favorites_saved"
        android:padding="4dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_vegetable" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/favoriteType"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_post_chip_light"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:minWidth="78dp"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:textColor="@color/primary_hover"
            android:textSize="@dimen/text_xs" />

        <TextView
            android:id="@+id/favoriteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:ellipsize="end"
            android:fontFamily="@font/inter_semibold"
            android:maxLines="2"
            android:textColor="@color/neutral_100"
            android:textSize="@dimen/text_md" />

        <TextView
            android:id="@+id/favoriteSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/neutral_60"
            android:textSize="@dimen/text_sm" />
    </LinearLayout>

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@string/favorites_open"
        android:src="@drawable/ic_chevron_right" />
</LinearLayout>
