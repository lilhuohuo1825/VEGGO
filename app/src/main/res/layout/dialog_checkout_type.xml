<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:text="Bạn muốn đặt hàng bằng vai trò nào?"
        android:textColor="#1E1E1E"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnOpenCheckout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_primary"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:text="Mua hàng bằng tài khoản VEGGO"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnOpenCheckoutGuest"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_normal"
        android:fontFamily="@font/inter_semibold"
        android:gravity="center"
        android:text="Tiếp tục với vai trò khách"
        android:textColor="#1E1E1E"
        android:textSize="14sp" />
</LinearLayout>
