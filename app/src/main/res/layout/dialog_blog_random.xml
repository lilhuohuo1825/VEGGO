<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blogRandomRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/neutral_10"
    android:orientation="vertical"
    android:padding="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="164dp">

        <ImageView
            android:id="@+id/blogRandomImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/blogRandomLabel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/white"
            android:background="@drawable/bg_post_chip_on_hero"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Bài viết hôm nay"
            android:textColor="@color/primary_hover"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/blogRandomTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:textColor="@color/neutral_100"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/blogRandomExcerpt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:textColor="@color/neutral_70"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/blogRandomReadButton"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:minWidth="96dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="Đọc ngay"
        android:textColor="@color/neutral_10"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
