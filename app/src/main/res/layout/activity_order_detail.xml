<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/orderDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/orderDetailHeader"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md">

        <ImageView
    android:id="@+id/orderDetailBackButton"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/orders_back"
    android:focusable="true"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_left"
    android:tint="@color/primary_hover" />

        <TextView
            android:id="@+id/orderDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/encodesans_bold"
            android:gravity="center"
            android:text="@string/order_detail_title"
            android:textColor="@color/neutral_100"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold" />

        <Space
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/orderDetailSwipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/orderDetailScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/orderDetailInfoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_order_detail_summary_card"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_code_label"
                        android:textColor="@color/neutral_80"
                        android:textSize="@dimen/text_sm" />

                    <ImageView
                        android:id="@+id/btnCopyOrderCode"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_copy"
                        android:tint="@color/primary_hover"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Copy Order Code" />

                    <TextView
                        android:id="@+id/orderDetailCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/primary_hover"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_status_label"
                        android:textColor="@color/neutral_80"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_order_delivered_chip"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:minWidth="76dp"
                        android:textColor="@color/primary_main"
                        android:textSize="@dimen/text_xs" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_time_label"
                        android:textColor="@color/neutral_80"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_payment_label"
                        android:textColor="@color/neutral_80"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailPayment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_warehouse_label"
                        android:textColor="@color/neutral_80"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailWarehouse"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="end"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:fontFamily="@font/encodesans_bold"
                android:text="Thông tin giao hàng"
                android:textColor="@color/primary_hover"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/orderDetailShippingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_order_detail_summary_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="Người nhận"
                        android:textColor="@color/neutral_80"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailReceiverName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="Số điện thoại"
                        android:textColor="@color/neutral_80"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailReceiverPhone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="Email"
                        android:textColor="@color/neutral_80"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailReceiverEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="Địa chỉ"
                        android:textColor="@color/neutral_80"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailReceiverAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="end"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/encodesans_bold"
                    android:text="@string/order_detail_products"
                    android:textColor="@color/primary_hover"
                    android:textSize="@dimen/text_md"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/orderDetailSelectAllRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/orderDetailSelectAllCheckBox"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:button="@null"
                        android:background="@drawable/selector_checkbox"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/inter_medium"
                        android:text="Chọn tất cả"
                        android:textColor="@color/neutral_80"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/orderDetailProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/encodesans_bold"
                android:text="Tổng đơn hàng"
                android:textColor="@color/primary_hover"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/orderDetailPaymentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_order_detail_summary_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_subtotal"
                        android:textColor="@color/neutral_90"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailSubtotalValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_discount_product"
                        android:textColor="@color/neutral_90"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailProductDiscountValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/primary_main"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_discount"
                        android:textColor="@color/neutral_90"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailDiscountValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/primary_main"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_shipping_fee"
                        android:textColor="@color/neutral_90"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailShippingFeeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="Điểm carbon nhận được"
                        android:textColor="@color/neutral_90"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailCarbonPointsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/primary_main"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@color/neutral_30" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_semibold"
                        android:text="@string/order_detail_total"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_md"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/orderDetailTotalValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/primary_main"
                        android:textSize="@dimen/text_lg"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/orderDetailBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/order_detail_bottom_bar_min_height"
        android:background="@drawable/bg_order_detail_bottom_bar"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_sm">

        <TextView
            android:id="@+id/orderDetailCancelButton"
            style="@style/Widget.Veggo.OrderActionButton.Cancel"
            android:text="@string/orders_cancel"
            android:visibility="gone" />

        <TextView
            android:id="@+id/orderDetailReturnButton"
            style="@style/Widget.Veggo.OrderActionButton.DangerOutline"
            android:text="@string/orders_return_refund"
            android:visibility="gone" />

        <TextView
            android:id="@+id/orderDetailReceivedButton"
            style="@style/Widget.Veggo.OrderActionButton.Primary"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/orders_received"
            android:visibility="gone" />

        <TextView
            android:id="@+id/orderDetailBuyAgainButton"
            style="@style/Widget.Veggo.OrderActionButton.Outline"
            android:text="@string/orders_buy_again"
            android:visibility="gone" />

        <TextView
            android:id="@+id/orderDetailReviewButton"
            style="@style/Widget.Veggo.OrderActionButton.Primary"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/reviews_action"
            android:visibility="gone" />

        <TextView
            android:id="@+id/orderDetailAddToFridgeButton"
            style="@style/Widget.Veggo.OrderActionButton.Primary"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/orders_add_to_fridge"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
