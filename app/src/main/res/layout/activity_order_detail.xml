<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orderDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/orderDetailHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md">

        <ImageView
    android:id="@+id/orderDetailBackButton"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/orders_back"
    android:focusable="true"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_left"
    android:tint="@color/primary_hover" />

        <TextView
            android:id="@+id/orderDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/encodesans_bold"
            android:gravity="center"
            android:text="@string/order_detail_title"
            android:textColor="@color/neutral_100"
            android:textSize="@dimen/text_xl"
            android:textStyle="bold" />

        <Space
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/orderDetailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/orderDetailInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_order_detail_summary_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_code_label"
                        android:textColor="@color/neutral_80"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/primary_hover"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_status_label"
                        android:textColor="@color/neutral_80"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_order_delivered_chip"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:minWidth="76dp"
                        android:textColor="@color/primary_main"
                        android:textSize="@dimen/text_xs" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_time_label"
                        android:textColor="@color/neutral_80"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_payment_label"
                        android:textColor="@color/neutral_80"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailPayment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_warehouse_label"
                        android:textColor="@color/neutral_80"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailWarehouse"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="end"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/encodesans_bold"
                    android:text="@string/order_detail_products"
                    android:textColor="@color/primary_hover"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/orderDetailSelectAllCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="Chọn tất cả"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/neutral_80"
                    android:textSize="@dimen/text_sm"
                    android:buttonTint="@color/primary_main"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/orderDetailProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <LinearLayout
                android:id="@+id/orderDetailPaymentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_order_detail_summary_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/encodesans_bold"
                    android:text="@string/order_detail_payment_total_title"
                    android:textColor="@color/neutral_100"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_subtotal"
                        android:textColor="@color/neutral_90"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailSubtotalValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_discount_product"
                        android:textColor="@color/neutral_90"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailProductDiscountValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/primary_main"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_discount"
                        android:textColor="@color/neutral_90"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailDiscountValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/primary_main"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/order_detail_shipping_fee"
                        android:textColor="@color/neutral_90"
                        android:textSize="@dimen/text_sm" />

                    <TextView
                        android:id="@+id/orderDetailShippingFeeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@color/neutral_30" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_semibold"
                        android:text="@string/order_detail_total"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_md"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/orderDetailTotalValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/danger_main"
                        android:textSize="@dimen/text_lg"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/orderDetailBottomActions"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@drawable/bg_order_detail_bottom_bar"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md">

        <TextView
            android:id="@+id/orderDetailCancelButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="92dp"
            android:background="@drawable/bg_order_cancel_button"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/orders_cancel"
            android:textColor="@color/primary_main"
            android:textSize="@dimen/text_sm"
            android:visibility="gone" />

        <TextView
            android:id="@+id/orderDetailReturnButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="92dp"
            android:background="@drawable/bg_order_danger_outline_button"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/orders_return_refund"
            android:textColor="@color/primary_main"
            android:textSize="@dimen/text_sm"
            android:visibility="gone" />

        <TextView
            android:id="@+id/orderDetailAddToFridgeButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="140dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/bg_order_primary_button"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Thêm vào tủ lạnh"
            android:textColor="@color/background_main"
            android:textSize="@dimen/text_sm"
            android:visibility="gone" />

        <TextView
            android:id="@+id/orderDetailReceivedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="92dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:background="@drawable/bg_order_primary_button"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/orders_received"
            android:textColor="@color/background_main"
            android:textSize="@dimen/text_sm"
            android:visibility="gone" />

        <TextView
            android:id="@+id/orderDetailBuyAgainButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="96dp"
            android:background="@drawable/bg_order_primary_button"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/orders_buy_again"
            android:textColor="@color/background_main"
            android:textSize="@dimen/text_sm"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
