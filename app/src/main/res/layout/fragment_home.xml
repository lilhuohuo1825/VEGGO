<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background_main"
    android:clipChildren="false">

    <ScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="100dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="10dp">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="?android:attr/actionBarSize"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:id="@+id/btnMenuCategory"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@string/nav_home"
                    android:src="@drawable/ic_category"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/neutral_100" />

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerInside"
                    android:src="@drawable/logo_full"
                    android:clickable="true"
                    android:focusable="true" />

                <FrameLayout
                    android:id="@+id/homeCartButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/nav_cart"
                        android:src="@drawable/ic_shopping_cart" />

                    <TextView
                        android:id="@+id/homeCartBadge"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_notification_badge_alert"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="2"
                        tools:visibility="visible" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/homeNotifyButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="Notifications"
                        android:src="@drawable/ic_notify" />

                    <TextView
                        android:id="@+id/homeNotificationBadge"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_notification_badge_alert"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="7"
                        tools:visibility="visible" />
                </FrameLayout>
            </LinearLayout>

            <!-- Search Bar -->
            <LinearLayout
                android:id="@+id/layoutSearch"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_home_search"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/primary_hover" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter"
                    android:text="Tìm kiếm"
                    android:textColor="#66167728"
                    android:textSize="16sp" />

                <FrameLayout
                    android:id="@+id/btnHomeCamera"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_home_mic"
                    android:clickable="true"
                    android:contentDescription="@string/scan_camera_title_ingredient"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/neutral_80" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnHomeMic"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_home_mic"
                    android:clickable="true"
                    android:contentDescription="@string/chat_voice_input"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_microphone"
                        app:tint="@color/neutral_80" />
                </FrameLayout>
            </LinearLayout>

            <!-- Utilities -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:text="Tiện ích"
                android:textColor="@color/neutral_100"
                android:textSize="18sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvUtilities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_home_utility" />

            <!-- Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="126dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="18dp"
                app:cardBackgroundColor="@color/neutral_10"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpBanners"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layoutIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <View
                    android:id="@+id/indicator1"
                    android:layout_width="14dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_indicator_selected" />

                <View
                    android:id="@+id/indicator2"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_indicator_unselected" />

                <View
                    android:id="@+id/indicator3"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_indicator_unselected" />

                <View
                    android:id="@+id/indicator4"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_indicator_unselected" />

                <View
                    android:id="@+id/indicator5"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_indicator_unselected" />

            </LinearLayout>

            <!-- Categories -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:text="Danh mục"
                    android:textColor="@color/neutral_100"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/btnViewMoreCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter"
                    android:text="@string/show_more"
                    android:textColor="@color/primary_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_home_category_horizontal" />

            <!-- Flash Sale -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_home_flash"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:text="Flash sale"
                            android:textColor="@color/neutral_100"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_fire" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnViewMoreFlashSale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/inter"
                        android:text="@string/show_more"
                        android:textColor="@color/primary_main"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFlashSale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="18dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_home_flash_sale" />
            </LinearLayout>

            <!-- Recipes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:text="@string/popular_recipes_title"
                    android:textColor="@color/neutral_100"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/btnViewMoreRecipes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter"
                    android:text="@string/show_more"
                    android:textColor="@color/primary_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_home_recipe" />

            <!-- Product Tabs (4 tabs, kết nối với /api/products/home?tab=...) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:scrollbars="none"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/tabContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <!-- Tab 1: Phổ biến (popular) – active by default -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">
                        <TextView
                            android:id="@+id/tabPopular"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:text="Phổ biến"
                            android:textColor="@color/primary_main"
                            android:textSize="14sp" />
                        <View
                            android:id="@+id/tabPopularIndicator"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_order_tab_indicator"
                            android:visibility="visible" />
                    </LinearLayout>

                    <!-- Tab 2: Bán chạy (trending) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="24dp"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">
                        <TextView
                            android:id="@+id/tabTrending"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter"
                            android:gravity="center"
                            android:text="Bán chạy"
                            android:textColor="@color/neutral_60"
                            android:textSize="14sp" />
                        <View
                            android:id="@+id/tabTrendingIndicator"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_order_tab_indicator"
                            android:visibility="invisible" />
                    </LinearLayout>

                    <!-- Tab 3: Mới nhất (newest) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="24dp"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">
                        <TextView
                            android:id="@+id/tabNewest"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter"
                            android:gravity="center"
                            android:text="Mới nhất"
                            android:textColor="@color/neutral_60"
                            android:textSize="14sp" />
                        <View
                            android:id="@+id/tabNewestIndicator"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_order_tab_indicator"
                            android:visibility="invisible" />
                    </LinearLayout>

                    <!-- Tab 4: Giá tốt (toggle cao/thấp) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="24dp"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">
                        <LinearLayout
                            android:id="@+id/tabBestPriceContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless">
                            <TextView
                                android:id="@+id/tabBestPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter"
                                android:gravity="center"
                                android:text="Giá"
                                android:textColor="@color/neutral_60"
                                android:textSize="14sp" />
                            <LinearLayout
                                android:id="@+id/homePriceArrowGroup"
                                android:layout_width="12dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:orientation="vertical"
                                android:gravity="center">
                                <ImageView
                                    android:id="@+id/homeImgPriceArrowUp"
                                    android:layout_width="12dp"
                                    android:layout_height="9dp"
                                    android:src="@drawable/ic_chevron_up"
                                    app:tint="@color/neutral_60" />
                                <ImageView
                                    android:id="@+id/homeImgPriceArrowDown"
                                    android:layout_width="12dp"
                                    android:layout_height="9dp"
                                    android:src="@drawable/ic_chevron_down"
                                    app:tint="@color/neutral_60" />
                            </LinearLayout>
                        </LinearLayout>
                        <View
                            android:id="@+id/tabBestPriceIndicator"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_order_tab_indicator"
                            android:visibility="invisible" />
                    </LinearLayout>

                    <!-- Tab 5: Đánh giá cao (top_rated) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="24dp"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">
                        <TextView
                            android:id="@+id/tabTopRated"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter"
                            android:gravity="center"
                            android:text="Đánh giá cao"
                            android:textColor="@color/neutral_60"
                            android:textSize="14sp" />
                        <View
                            android:id="@+id/tabTopRatedIndicator"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_order_tab_indicator"
                            android:visibility="invisible" />
                    </LinearLayout>

                    <!-- Tab 6: Khuyến mãi (promotion) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="24dp"
                        android:orientation="vertical"
                        android:gravity="bottom|center_horizontal">
                        <TextView
                            android:id="@+id/tabPromotion"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter"
                            android:gravity="center"
                            android:text="@string/home_tab_promotion"
                            android:textColor="@color/neutral_60"
                            android:textSize="14sp" />
                        <View
                            android:id="@+id/tabPromotionIndicator"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_order_tab_indicator"
                            android:visibility="invisible" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/neutral_30" />

            <!-- Neo cuộn cho danh sách sản phẩm -->
            <View
                android:id="@+id/productAnchor"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <!-- Products Grid -->
            <!-- ProgressBar hiển thị khi đang tải sản phẩm từ API -->
            <ProgressBar
                android:id="@+id/progressProducts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:indeterminateTint="@color/primary_main"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="7dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:listitem="@layout/item_product_grid" />

            <LinearLayout
                android:id="@+id/homeProductsEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_xl"
                android:paddingTop="32dp"
                android:paddingEnd="@dimen/spacing_xl"
                android:paddingBottom="48dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:contentDescription="@string/products_empty_title"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mascot_sad" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:fontFamily="@font/encodesans_bold"
                    android:gravity="center"
                    android:text="@string/products_empty_title"
                    android:textColor="@color/neutral_100"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/products_empty_body"
                    android:textColor="@color/neutral_70"
                    android:textSize="@dimen/text_sm" />
            </LinearLayout>

            <!-- Nút "Xem thêm" (tải phân trang) -->
            <LinearLayout
                android:id="@+id/btnLoadMore"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Xem thêm"
                    android:textColor="@color/primary_main"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/primary_main"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/stickyHeader"
        layout="@layout/layout_home_sticky_header" />

    <!-- Sticky Product Tabs – nằm dưới stickyHeader (top=64dp), show khi scroll tới tabs section -->
    <include
        android:id="@+id/stickyTabs"
        layout="@layout/layout_home_sticky_tabs" />

    <!-- Floating Chatbot Icon -->
    <ImageView
        android:id="@+id/btnChatbot"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="96dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/chatbot_fab_content_description"
        android:elevation="8dp"
        android:focusable="true"
        android:src="@drawable/ic_chatbot" />

</FrameLayout>
