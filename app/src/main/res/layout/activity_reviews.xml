<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingStart="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
    android:id="@+id/reviewsBackButton"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/orders_back"
    android:focusable="true"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_left"
    android:tint="@color/primary_hover" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/encodesans_bold"
                android:gravity="center"
                android:text="@string/reviews_title"
                android:textColor="@color/neutral_100"
                android:textSize="@dimen/text_xl"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/orders_menu"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_order_list_menu" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/reviewWaitingTab"
                    android:layout_width="156dp"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/reviewWaitingTabText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:text="@string/reviews_tab_waiting"
                            android:textColor="@color/primary_main"
                            android:textSize="@dimen/text_sm"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/reviewWaitingTabBadge"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_notification_badge_alert"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:textColor="@color/background_main"
                            android:textSize="@dimen/text_xs"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/reviewWaitingIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/bg_order_tab_indicator" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/reviewDoneTab"
                    android:layout_width="132dp"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/reviewDoneTabText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:text="@string/reviews_tab_done"
                            android:textColor="@color/neutral_60"
                            android:textSize="@dimen/text_sm" />

                        <TextView
                            android:id="@+id/reviewDoneTabBadge"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_notification_badge_dark"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:textColor="@color/background_main"
                            android:textSize="@dimen/text_xs"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/reviewDoneIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/bg_order_tab_indicator"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/reviewWaitingList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical">

            <include layout="@layout/item_review_waiting" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reviewDoneList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/item_review_done" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
