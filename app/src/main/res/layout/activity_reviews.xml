<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingStart="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/reviewsBackButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/orders_back"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_left" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/encodesans_bold"
                android:gravity="center"
                android:text="@string/reviews_title"
                android:textColor="@color/neutral_100"
                android:textSize="@dimen/text_xl"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/orders_menu"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_order_list_menu" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/reviewWaitingTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/reviewWaitingTabText"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semibold"
                    android:gravity="center"
                    android:text="@string/reviews_tab_waiting"
                    android:textColor="@color/primary_main"
                    android:textSize="@dimen/text_sm" />

                <ImageView
                    android:id="@+id/reviewWaitingIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_order_tab_indicator" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reviewDoneTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/reviewDoneTabText"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="@string/reviews_tab_done"
                    android:textColor="@color/neutral_60"
                    android:textSize="@dimen/text_sm" />

                <ImageView
                    android:id="@+id/reviewDoneIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_order_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reviewWaitingList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical">

            <include layout="@layout/item_review_waiting" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reviewDoneList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/item_review_done" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
