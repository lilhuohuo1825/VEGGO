<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="104dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/personalInfoBackButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/orders_back"
                    android:focusable="true"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_left" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/encodesans_bold"
                    android:gravity="center"
                    android:text="Thông tin cá nhân"
                    android:textColor="@color/neutral_100"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="40dp"
                    android:layout_height="40dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_profile_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="24dp"
                android:paddingEnd="16dp"
                android:paddingBottom="18dp">

                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:background="@drawable/bg_profile_avatar">

                    <ImageView
                        android:id="@+id/personalInfoAvatarImage"
                        android:layout_width="74dp"
                        android:layout_height="74dp"
                        android:layout_gravity="center"
                        android:contentDescription="Ảnh đại diện"
                        android:src="@drawable/ic_profile_avatar" />

                    <TextView
                        android:id="@+id/personalInfoChangeAvatarButton"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="end|bottom"
                        android:background="@drawable/bg_community_circle_green"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/neutral_10"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/personalInfoCarbonBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_carbon_badge"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="142dp"
                    android:textColor="@color/primary_main"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/personalInfoChangePasswordButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Đổi mật khẩu"
                    android:textColor="@color/primary_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_profile_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="22dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Họ và tên"
                    android:textColor="@color/neutral_100"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/personalInfoNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Nhập họ và tên"
                    android:inputType="textPersonName"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/neutral_100"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/personalInfoNameError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/danger_main"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Số điện thoại"
                        android:textColor="@color/neutral_100"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/personalInfoChangePhoneButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_carbon_badge"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:minWidth="122dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Đổi số điện thoại"
                        android:textColor="@color/primary_main"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/personalInfoPhoneInput"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:clickable="false"
                    android:enabled="false"
                    android:focusable="false"
                    android:hint="Số điện thoại"
                    android:inputType="phone"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/neutral_60"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/personalInfoPhoneError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/danger_main"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Email"
                    android:textColor="@color/neutral_100"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/personalInfoEmailInput"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Nhập email"
                    android:inputType="textEmailAddress"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/neutral_100"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/personalInfoEmailError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/danger_main"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Ngày sinh"
                            android:textColor="@color/neutral_100"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/personalInfoBirthdayEditContainer"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="8dp">

                            <EditText
                                android:id="@+id/personalInfoBirthdayInput"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_input"
                                android:hint="Ngày sinh"
                                android:inputType="date"
                                android:paddingStart="14dp"
                                android:paddingEnd="40dp"
                                android:textColor="@color/neutral_100"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/personalInfoBirthdayIcon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="12dp"
                                android:contentDescription="Ngày sinh"
                                android:src="@drawable/ic_calendar"
                                android:tint="@color/neutral_40" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/personalInfoBirthdayDisplay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/neutral_100"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/personalInfoBirthdayError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/danger_main"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Giới tính"
                            android:textColor="@color/neutral_100"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/personalInfoGenderEditContainer"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_input"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <LinearLayout
                                android:id="@+id/layoutGenderMale"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:clickable="true"
                                android:focusable="true">

                                <CheckBox
                                    android:id="@+id/personalInfoGenderMaleCheck"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:button="@null"
                                    android:background="@drawable/selector_checkbox"
                                    android:clickable="false"
                                    android:focusable="false" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="@font/inter_regular"
                                    android:text="Nam"
                                    android:textColor="@color/neutral_100"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutGenderFemale"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginStart="16dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:clickable="true"
                                android:focusable="true">

                                <CheckBox
                                    android:id="@+id/personalInfoGenderFemaleCheck"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:button="@null"
                                    android:background="@drawable/selector_checkbox"
                                    android:clickable="false"
                                    android:focusable="false" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="@font/inter_regular"
                                    android:text="Nữ"
                                    android:textColor="@color/neutral_100"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/personalInfoGenderDisplay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/neutral_100"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@color/neutral_10"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/personalInfoLogoutButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_logout_outline_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Đăng xuất"
            android:textColor="@color/danger_main"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/personalInfoSaveButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Chỉnh sửa"
            android:textColor="@color/neutral_10"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
