<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_10"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/cookbookTopHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:background="@color/neutral_10"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/cookbookBackButton"
            android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_community_circle"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
            android:clipChildren="false"
            android:clipToPadding="false">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:scaleType="centerInside"
            app:tint="#57AF37"
                android:src="@drawable/ic_left"
                android:contentDescription="" />
        </FrameLayout>

        <TextView
            android:id="@+id/cookbookTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Cookbook"
            android:textColor="@color/neutral_100"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cookbookCount"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_community_chip"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="0 công thức"
            android:textColor="@color/primary_main"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/cookbookShareButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_community_circle"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                app:tint="#57AF37"
                android:src="@drawable/ic_share_green"
                android:contentDescription="" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cookbookTopHeader">

        <LinearLayout
            android:id="@+id/cookbookMasonryRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:id="@+id/cookbookLeftColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/cookbookRightColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
