<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/blogCommentAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_community_avatar"
        android:gravity="center"
        android:text="B"
        android:textColor="@color/neutral_10"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/blogCommentName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/neutral_100"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/blogCommentAvatar"
        app:layout_constraintTop_toTopOf="@id/blogCommentAvatar" />

    <TextView
        android:id="@+id/blogCommentContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:textColor="@color/neutral_80"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/blogCommentAvatar"
        app:layout_constraintTop_toBottomOf="@id/blogCommentName" />

    <TextView
        android:id="@+id/blogCommentMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:text="Vừa xong"
        android:textColor="@color/neutral_60"
        android:textSize="11sp"
        app:layout_constraintStart_toEndOf="@id/blogCommentAvatar"
        app:layout_constraintTop_toBottomOf="@id/blogCommentContent" />

    <TextView
        android:id="@+id/blogCommentLike"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:gravity="center"
        android:minWidth="52dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="♥ 0"
        android:textColor="@color/neutral_60"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/blogCommentMeta"
        app:layout_constraintStart_toEndOf="@id/blogCommentMeta"
        app:layout_constraintTop_toTopOf="@id/blogCommentMeta" />
</androidx.constraintlayout.widget.ConstraintLayout>
