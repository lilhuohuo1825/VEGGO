<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orderItemProductBlock"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/orderItemProductRow"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/orderItemProductImage"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_order_product_thumb"
            android:contentDescription="@string/orders_sample_product_name"
            android:padding="@dimen/spacing_sm"
            android:scaleType="centerInside"
            android:src="@drawable/ic_vegetable" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/orderItemProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_semibold"
                android:maxLines="1"
                android:text="@string/orders_sample_product_name"
                android:textColor="@color/neutral_100"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/orderItemVariant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/orders_sample_variant"
                    android:textColor="@color/neutral_70"
                    android:textSize="@dimen/text_xs" />

                <TextView
                    android:id="@+id/orderItemQuantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/orders_sample_quantity"
                    android:textColor="@color/neutral_100"
                    android:textSize="@dimen/text_xs" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="78dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/orderItemOldPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/orders_sample_old_price"
                android:textColor="@color/neutral_50"
                android:textSize="@dimen/text_xs" />

            <TextView
                android:id="@+id/orderItemPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/orders_sample_price"
                android:textColor="@color/neutral_100"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/neutral_30" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/orderItemTotalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:text="@string/orders_total_label"
            android:textColor="@color/neutral_100"
            android:textSize="@dimen/text_sm" />

        <TextView
            android:id="@+id/orderItemTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/orders_sample_total"
            android:textColor="@color/primary_main"
            android:textSize="@dimen/text_md"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
