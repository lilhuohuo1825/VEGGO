<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cookbook_dialog"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="24dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Thêm vào cookbook"
        android:textColor="@color/neutral_100"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Thêm công thức này vào cookbook của bạn"
        android:textColor="@color/neutral_80"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/cookbookOptionList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/cookbookCreateButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ic_plussss"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_plus" />

        <TextView
            android:id="@+id/cookbookSaveButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary_large"
            android:gravity="center"
            android:text="Lưu"
            android:textColor="@color/neutral_10"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
