<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/carbonBackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/orders_back"
            android:focusable="true"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_left"
            android:tint="@color/primary_hover" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:text="@string/carbon_title"
            android:textColor="#1E1E1E"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.3dp"
        android:background="#616161" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_carbon_hero_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/bg_carbon_icon_circle">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/carbon_title"
                            android:src="@drawable/ic_profile_leaf" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_lg"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/carbon_current_label"
                            android:textColor="@color/neutral_100"
                            android:textSize="@dimen/text_md" />

                        <TextView
                            android:id="@+id/carbonCurrentValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:fontFamily="@font/encodesans_bold"
                            android:textColor="@color/neutral_100"
                            android:textSize="42sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/carbonCurrentLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:background="@drawable/bg_carbon_badge"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:minWidth="150dp"
                            android:textColor="@color/primary_hover"
                            android:textSize="@dimen/text_sm" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/encodesans_bold"
                        android:text="Ưu đãi theo chứng nhận"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_lg"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/carbonPromotionBannerCard"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:visibility="gone"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/carbonPromotionBanners"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/carbonPromotionIndicators"
                    android:layout_width="wrap_content"
                    android:layout_height="8dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:id="@+id/carbonPromotionIndicator1"
                        android:layout_width="14dp"
                        android:layout_height="4dp"
                        android:background="@drawable/bg_indicator_selected" />

                    <View
                        android:id="@+id/carbonPromotionIndicator2"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_indicator_unselected" />

                    <View
                        android:id="@+id/carbonPromotionIndicator3"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_indicator_unselected" />

                    <View
                        android:id="@+id/carbonPromotionIndicator4"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_indicator_unselected" />

                    <View
                        android:id="@+id/carbonPromotionIndicator5"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_indicator_unselected" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_profile_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/encodesans_bold"
                        android:text="@string/carbon_next_certificate"
                        android:textColor="@color/neutral_100"
                        android:textSize="@dimen/text_lg"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/carbonNextLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_carbon_badge"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/primary_hover"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/carbonProgressValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/primary_hover"
                        android:textSize="@dimen/text_md" />

                    <TextView
                        android:id="@+id/carbonProgressLeft"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/neutral_70"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/carbonProgressTrack"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/bg_carbon_progress_track">

                    <View
                        android:id="@+id/carbonProgressFill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_carbon_progress_fill" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/carbon_certificate_hint"
                    android:textColor="@color/neutral_70"
                    android:textSize="@dimen/text_sm" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_profile_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/encodesans_bold"
                    android:text="@string/carbon_earn_title"
                    android:textColor="@color/neutral_100"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:drawableStart="@drawable/ic_profile_leaf"
                    android:drawablePadding="@dimen/spacing_md"
                    android:gravity="center_vertical"
                    android:text="@string/carbon_earn_buy"
                    android:textColor="@color/neutral_100"
                    android:textSize="@dimen/text_md" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:drawableStart="@drawable/ic_profile_leaf"
                    android:drawablePadding="@dimen/spacing_md"
                    android:gravity="center_vertical"
                    android:text="@string/carbon_earn_review"
                    android:textColor="@color/neutral_100"
                    android:textSize="@dimen/text_md" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:background="@color/background_main"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <TextView
            android:id="@+id/carbonHistoryButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_order_primary_button"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/carbon_history_button"
            android:textColor="@color/background_main"
            android:textSize="@dimen/text_sm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/carbonCertificateButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:background="@drawable/bg_order_cancel_button"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/carbon_certificate_button"
            android:textColor="@color/primary_main"
            android:textSize="@dimen/text_sm"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
