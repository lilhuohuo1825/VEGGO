<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F9"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:padding="4dp"
            android:src="@drawable/ic_left"
            app:tint="@color/primary_hover" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/inter"
            android:text="Chuyển tiền VeggoPay"
            android:textColor="#1E1E1E"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Main View Switcher for Input Form vs Success Receipt -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Form View Container -->
        <RelativeLayout
            android:id="@+id/layoutFormContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:id="@+id/scrollFormView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/btnSubmitTransfer"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Source Account Card -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/inter_bold"
                        android:text="Nguồn chuyển tiền"
                        android:textColor="#1E1E1E"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="TÀI KHOẢN THANH TOÁN"
                                android:textColor="#2E7D32"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvSourceBalance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/inter_bold"
                                android:text="0 ₫"
                                android:textColor="#1E1E1E"
                                android:textSize="20sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Transfer To (Chuyển đến) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/inter_bold"
                        android:text="Chuyển đến"
                        android:textColor="#1E1E1E"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="VÍ VEGGOPAY LIÊN KẾT"
                                android:textColor="#2E7D32"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/edtRecipientPhone"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_input"
                                android:fontFamily="@font/inter"
                                android:hint="Số tài khoản / Số điện thoại"
                                android:inputType="phone"
                                android:paddingHorizontal="14dp"
                                android:textColor="#1E1E1E"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvRecipientStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="#F5F5F5"
                                android:fontFamily="@font/inter_medium"
                                android:padding="10dp"
                                android:textColor="#1E1E1E"
                                android:textSize="13sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Amount & Note Input Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="Số tiền chuyển (đ)"
                                android:textColor="#1E1E1E"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/edtAmount"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_input"
                                android:fontFamily="@font/inter_bold"
                                android:hint="0 ₫"
                                android:inputType="number"
                                android:paddingHorizontal="14dp"
                                android:textColor="#1E1E1E"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:fontFamily="@font/inter_bold"
                                android:text="Lời nhắn chuyển tiền"
                                android:textColor="#1E1E1E"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/edtNote"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_input"
                                android:fontFamily="@font/inter"
                                android:gravity="top"
                                android:hint="Nhập nội dung chuyển tiền..."
                                android:inputType="textMultiLine"
                                android:padding="14dp"
                                android:textColor="#1E1E1E"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </ScrollView>

            <!-- Transfer Action Button pinned at the bottom -->
            <TextView
                android:id="@+id/btnSubmitTransfer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_alignParentBottom="true"
                android:layout_margin="16dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="@font/inter_bold"
                android:gravity="center"
                android:text="Chuyển tiền"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </RelativeLayout>

        <!-- Success Receipt View (Initially Gone) -->
        <LinearLayout
            android:id="@+id/layoutReceiptView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="32dp"
                android:src="@drawable/ic_success" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/inter_bold"
                android:text="Chuyển tiền thành công"
                android:textColor="@color/primary_main"
                android:textSize="20sp" />

            <!-- Receipt Card Detail -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="#F9F9FB"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvReceiptAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="100.000 ₫"
                        android:textColor="#1E1E1E"
                        android:textSize="24sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="#E0E0E0" />

                    <!-- Recipient detail row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:text="Người nhận"
                            android:textColor="#888888"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tvReceiptRecipient"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_medium"
                            android:gravity="end"
                            android:text="Nguyễn Văn B (0987654321)"
                            android:textColor="#1E1E1E"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Message detail row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:text="Lời nhắn"
                            android:textColor="#888888"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tvReceiptNote"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_medium"
                            android:gravity="end"
                            android:text="Chuyển tiền ăn trưa"
                            android:textColor="#1E1E1E"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Transaction code row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:text="Mã giao dịch"
                            android:textColor="#888888"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tvReceiptTxId"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_medium"
                            android:gravity="end"
                            android:text="VP98273618"
                            android:textColor="#1E1E1E"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/btnReceiptDone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="Hoàn thành"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
