<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="112dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
    android:id="@+id/addressFormBackButton"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:contentDescription="@string/orders_back"
    android:focusable="true"
    android:padding="6dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_left"
    android:tint="@color/primary_hover" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/encodesans_bold"
                    android:gravity="center"
                    android:text="@string/address_add_title"
                    android:textColor="@color/neutral_100"
                    android:textSize="@dimen/text_xl"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="40dp"
                    android:layout_height="40dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/encodesans_bold"
                    android:text="@string/address_personal_info"
                    android:textColor="@color/neutral_100"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/addressNameLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/address_full_name"
                            android:textColor="@color/neutral_100"
                            android:textSize="@dimen/text_sm" />

                        <EditText
                            android:id="@+id/addressNameInput"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:background="@drawable/bg_input"
                            android:inputType="textPersonName"
                            android:paddingStart="@dimen/spacing_md"
                            android:paddingEnd="@dimen/spacing_md"
                            android:textColor="@color/neutral_100"
                            android:textSize="@dimen/text_sm" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/addressPhoneLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/address_phone"
                            android:textColor="@color/neutral_100"
                            android:textSize="@dimen/text_sm" />

                        <EditText
                            android:id="@+id/addressPhoneInput"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:background="@drawable/bg_input"
                            android:inputType="phone"
                            android:paddingStart="@dimen/spacing_md"
                            android:paddingEnd="@dimen/spacing_md"
                            android:textColor="@color/neutral_100"
                            android:textSize="@dimen/text_sm" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/address_email"
                    android:textColor="@color/neutral_100"
                    android:textSize="@dimen/text_sm" />

                <EditText
                    android:id="@+id/addressEmailInput"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/bg_input"
                    android:inputType="textEmailAddress"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:textColor="@color/neutral_100"
                    android:textSize="@dimen/text_sm" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_profile_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/encodesans_bold"
                    android:text="@string/address_shipping_info"
                    android:textColor="@color/neutral_100"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/addressCityLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/address_city"
                            android:textColor="@color/neutral_100"
                            android:textSize="@dimen/text_sm" />

                        <TextView
                            android:id="@+id/addressCityInput"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:background="@drawable/bg_input"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/spacing_md"
                            android:paddingEnd="@dimen/spacing_md"
                            android:text="@string/address_city_hint"
                            android:textColor="@color/neutral_60"
                            android:textSize="@dimen/text_sm" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/addressDistrictLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/address_district"
                            android:textColor="@color/neutral_100"
                            android:textSize="@dimen/text_sm" />

                        <TextView
                            android:id="@+id/addressDistrictInput"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:background="@drawable/bg_input"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/spacing_md"
                            android:paddingEnd="@dimen/spacing_md"
                            android:text="@string/address_district_hint"
                            android:textColor="@color/neutral_60"
                            android:textSize="@dimen/text_sm" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/addressWardLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/address_ward"
                    android:textColor="@color/neutral_100"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/addressWardInput"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:text="@string/address_ward_hint"
                    android:textColor="@color/neutral_60"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/addressDetailLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/address_detail"
                    android:textColor="@color/neutral_100"
                    android:textSize="@dimen/text_sm" />

                <EditText
                    android:id="@+id/addressDetailInput"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/bg_input"
                    android:hint="@string/address_detail_hint"
                    android:inputType="textPostalAddress"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:textColor="@color/neutral_100"
                    android:textColorHint="@color/neutral_60"
                    android:textSize="@dimen/text_sm" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/addressDefaultCheckbox"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_address_checkbox" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:text="@string/address_make_default"
                        android:textColor="@color/neutral_70"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_gravity="bottom"
        android:background="@color/background_main"
        android:elevation="8dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <TextView
            android:id="@+id/addressCancelButton"
            android:layout_width="96dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_order_cancel_button"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/address_cancel"
            android:textColor="@color/primary_main"
            android:textSize="@dimen/text_sm" />

        <TextView
            android:id="@+id/addressDoneButton"
            android:layout_width="130dp"
            android:layout_height="46dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/bg_order_primary_button"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/address_done"
            android:textColor="@color/background_main"
            android:textSize="@dimen/text_sm" />
    </LinearLayout>
</FrameLayout>
