<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_order_card"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="108dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_post_media">

            <ImageView
                android:id="@+id/myPostImage"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_post_hero"
                android:padding="@dimen/spacing_lg"
                android:src="@drawable/ic_vegetable" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/myPostTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:lineSpacingExtra="2dp"
                android:text="Canh cải kale nấu tôm cho bữa tối"
                android:textColor="@color/neutral_100"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/myPostContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:lineSpacingExtra="2dp"
                android:text="Công thức 15 phút, tận dụng rau hữu cơ còn trong tủ."
                android:textColor="@color/neutral_70"
                android:textSize="@dimen/text_sm" />

            <TextView
                android:id="@+id/myPostStatus"
                android:layout_width="90dp"
                android:layout_height="34dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_post_chip_outline"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="@string/posts_status_published"
                android:textColor="@color/primary_main"
                android:textSize="@dimen/text_sm" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/spacing_md"
        android:background="@color/neutral_30" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/myPostLikes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="128 tym"
            android:textColor="@color/neutral_70"
            android:textSize="@dimen/text_sm" />

        <TextView
            android:id="@+id/myPostComments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:text="24 bình luận"
            android:textColor="@color/neutral_70"
            android:textSize="@dimen/text_sm" />

        <TextView
            android:id="@+id/myPostSaves"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:text="36 lưu"
            android:textColor="@color/neutral_70"
            android:textSize="@dimen/text_sm" />

        <TextView
            android:id="@+id/myPostDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Hôm nay"
            android:textColor="@color/neutral_70"
            android:textSize="@dimen/text_sm" />
    </LinearLayout>
</LinearLayout>
