<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="150dp"
    android:layout_height="190dp"
    android:background="@drawable/bg_community_chip"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="14dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/suggestedAvatar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/suggestedName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/neutral_100"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/suggestedMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/neutral_70"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/suggestedFollowButton"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_follow_button_green"
        android:gravity="center"
        android:text="Theo dõi"
        android:textColor="@color/neutral_10"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
