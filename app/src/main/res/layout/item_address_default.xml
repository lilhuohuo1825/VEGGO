<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/addressDefaultItemCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_address_default_card"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/addressDefaultItemName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter_semibold"
            android:maxLines="1"
            android:minHeight="32dp"
            android:gravity="center_vertical"
            android:text="@string/address_sample_name"
            android:textColor="@color/neutral_100"
            android:textSize="@dimen/text_md"
            android:textStyle="bold" />

        <TextView
            android:layout_width="58dp"
            android:layout_height="28dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:background="@drawable/bg_default_yellow"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:text="@string/address_default"
            android:textColor="@color/background_main"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/addressDefaultItemPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:fontFamily="@font/inter_regular"
        android:text="@string/address_sample_phone"
        android:textColor="@color/neutral_100"
        android:textSize="@dimen/text_md" />

    <TextView
        android:id="@+id/addressDefaultItemLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:text="@string/address_sample_line"
        android:textColor="@color/neutral_90"
        android:textSize="@dimen/text_md" />

</LinearLayout>
