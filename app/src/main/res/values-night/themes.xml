<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.VEGGO" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary_main</item>
        <item name="colorSecondary">@color/primary_main</item>
        <item name="colorTertiary">@color/primary_main</item>
        <item name="colorControlActivated">@color/primary_main</item>
        <item name="colorAccent">@color/primary_main</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>

    <style name="Theme.VEGGO.NoActionBar" parent="Theme.VEGGO">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Splash Screen Theme for Dark Mode -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.VEGGO.NoActionBar</item>
    </style>
</resources>
