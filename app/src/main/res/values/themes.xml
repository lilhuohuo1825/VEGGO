<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.VEGGO" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/primary_main</item>
        <item name="colorPrimaryContainer">@color/primary_bg</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/secondary_main</item>
        <item name="colorSecondaryContainer">@color/secondary_bg</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/background_main</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/black</item>
<!--        <item name="android:windowLightStatusBar">false</item>-->

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/background_main</item>
<!--        <item name="android:windowLightNavigationBar">true</item>-->

        <!-- Text -->
        <item name="android:textColorPrimary">@color/neutral_100</item>
        <item name="android:textColorSecondary">@color/neutral_80</item>

        <!-- Font mặc định -->
        <item name="fontFamily">@font/inter_regular</item>

    </style>

    <style name="Theme.VEGGO" parent="Base.Theme.VEGGO" />
</resources>

